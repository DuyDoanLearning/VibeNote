{
  "name": "vibenote",
  "productName": "VibeNote",
  "version": "0.1.0",
  "description": "A Markdown note-taking app that stores notes as plain .md files.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build": "esbuild src/renderer.js --bundle --minify --format=iife --outfile=dist/renderer.js",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-packager . VibeNote --platform=darwin --out=release --overwrite --ignore=\"^/(src|release|node_modules|README.md)\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.3.1",
    "esbuild": "^0.28.2"
  }
}
