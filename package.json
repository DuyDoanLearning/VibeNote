{
  "name": "vibenote",
  "productName": "VibeNote",
  "version": "0.1.0",
  "description": "A Markdown note-taking app that stores notes as plain .md files.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-packager . VibeNote --platform=darwin --out=release --overwrite --icon=build/icon.icns --ignore=\"^/(src|release|node_modules|README.md|build.mjs|CLAUDE.md|scripts|build/|src-main)\"",
    "smoke": "npm run build && electron scripts/smoke-test.js",
    "icon": "electron scripts/make-icon.js"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electron/packager": "^20.3.0",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-vim": "^6.4.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "electron": "^45.3.1",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "marked": "^18.2.0",
    "marked-footnote": "^1.4.0",
    "mermaid": "^12.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DuyDoanLearning/VibeNote.git"
  }
}
